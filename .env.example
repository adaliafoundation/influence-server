# Local development from source.
NODE_ENV=development

# Official prerelease image without starter pack provisioning.
# NODE_ENV=prerelease

# Official prerelease starter pack provisioner using STARKNET_STARTER_PACK_PRIVATE_KEY.
# NODE_ENV=prerelease

# Official production image without starter pack provisioning.
# NODE_ENV=production

# Official production starter pack provisioner using a mounted key file and compose.provisioner-keyfile.yaml.
# NODE_ENV=production

# Set to 1 only for the official provisioner node.
STARTER_PACK_PROVISIONER_ENABLED=0

# Starter pack provisioner config.
# STARKNET_STARTER_PACK_ADMIN=0x...
# STARKNET_RPC_PROVIDER=https://...
# STARKNET_STARTER_PACK_PRIVATE_KEY=0x...
# STARKNET_STARTER_PACK_PRIVATE_KEY_FILE=/run/secrets/starter_pack_admin_private_key
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_STARTER_PACK_EXPLORER_PRODUCT_ID=prod_...
# STRIPE_STARTER_PACK_STRATEGIST_PRODUCT_ID=prod_...
# STRIPE_STARTER_PACK_INDUSTRIALIST_PRODUCT_ID=prod_...

# AVNU gasfree paymaster proxy. Keep this key server-side.
# AVNU_PAYMASTER_ENABLED=1
# AVNU_PAYMASTER_API_KEY=...
# AVNU_PAYMASTER_MAX_STARTER_PACK_BUDGET_STRK=100
# AVNU_PAYMASTER_RESERVATION_TTL_SECONDS=300
# AVNU_PAYMASTER_URL=https://sepolia.paymaster.avnu.fi
# AVNU_PAYMASTER_RATE_LIMIT_PER_MINUTE=120
# AVNU_PAYMASTER_REQUEST_TIMEOUT_MS=10000

# Banxa hosted checkout proxy. Keep this key server-side.
# BANXA_CHECKOUT_ENABLED=1
# BANXA_API_KEY=...
# BANXA_PARTNER_REF=...
# BANXA_BASE_URL=https://api.banxa-sandbox.com
# BANXA_REQUEST_TIMEOUT_MS=10000
# BANXA_WEBHOOK_API_KEY=...
# BANXA_WEBHOOK_SECRET=...
